      <bpmn:sequenceFlow id="edge_eventSubprocessStagesEnteredInclusiveGateway-startStageSlaMessageEvent_Stage_Supv7a" sourceRef="eventSubprocessStagesEnteredInclusiveGateway" targetRef="startStageSlaMessageEvent_Stage_Supv7a">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions.stagesEntered.some((stage) =&gt; stage.stageName == 'Supervisor review'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesEnteredInclusiveGateway-startStageSlaMessageEvent_Stage_Clos9a" sourceRef="eventSubprocessStagesEnteredInclusiveGateway" targetRef="startStageSlaMessageEvent_Stage_Clos9a">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions.stagesEntered.some((stage) =&gt; stage.stageName == 'Closure and communication'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesEnteredInclusiveGateway-eventSubprocessNoValidStagesToEnterEndEvent" sourceRef="eventSubprocessStagesEnteredInclusiveGateway" targetRef="eventSubprocessNoValidStagesToEnterEndEvent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(!vars.caseManagerDecisions.stagesEntered.some((stage) =&gt; stage.stageName == 'Intake and triage' || stage.stageName == 'Evidence acquisition and validation' || stage.stageName == 'Investigation' || stage.stageName == 'Provider record request' || stage.stageName == 'Supervisor review' || stage.stageName == 'Closure and communication'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="eventSubprocessNoTasksToRunEdge" sourceRef="eventSubprocessExclusiveGateway" targetRef="noTasksToRunExclusiveGateway" />
