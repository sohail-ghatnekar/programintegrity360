      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_runTasksInclusiveGateway-tCLM2pull_SendMessageEndEvent" sourceRef="runTasksInclusiveGateway" targetRef="tCLM2pull_SendMessageEndEvent">
