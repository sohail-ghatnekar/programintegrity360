            <uipath:context>
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"caseDeterministicRules":{"type":"object"},"caseCurrentExecutionState":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseDeterministicRules":{"case":{"completionConditions":[{"completionConditionType":"StagesCompleted","parameters":{"stageNames":["Intake and triage","Evidence acquisition and validation","Investigation","Closure and communication"]},"ruleName":"All required stages completed"}]},"stages":[{"name":"Intake and triage","entryConditions":[{"entryConditionType":"CaseEntered","parameters":{},"ruleName":"Case entered"}],"exitConditions":[],"completionConditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["API - intake claim and select CaseType profile","Agentic Caseworker - explain triage recommendation"]},"ruleName":"Intake complete"}],"tasks":[{"name":"API - intake claim and select CaseType profile","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Intake and triage"]},"ruleName":"When intake stage starts"}]},{"name":"Agentic Caseworker - explain triage recommendation","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["API - intake claim and select CaseType profile"]},"ruleName":"After case intake"}]}]},{"name":"Evidence acquisition and validation","entryConditions":[{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Intake and triage"]},"ruleName":"Triage stage completed"},{"operator":"AND","conditions":[{"entryConditionType":"StagesExited","parameters":{"stageNames":["Investigation"],"cancelStagesAndTasks":true}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Evcol2'","expressionString":"vars.caseManagerNextStageId === 'Stage_Evcol2'","cancelStagesAndTasks":true}}],"ruleName":"Case Manager requested evidence refresh"}],"exitConditions":[],"completionConditions":[{"operator":"AND","conditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Flow - acquire and validate claim evidence"]}},{"completionConditionType":"Expression","parameters":{"expression":"=js:vars.recommendedStageId === 'Stage_Prreq6'","expressionString":"vars.recommendedStageId === 'Stage_Prreq6'"}}],"ruleName":"Flow recommends provider record request"},{"operator":"AND","conditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Flow - acquire and validate claim evidence"]}},{"completionConditionType":"Expression","parameters":{"expression":"=js:vars.recommendedStageId === 'Stage_Corr4a'","expressionString":"vars.recommendedStageId === 'Stage_Corr4a'"}}],"ruleName":"Flow recommends investigation"}],"tasks":[{"name":"Flow - acquire and validate claim evidence","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Evidence acquisition and validation"]},"ruleName":"When evidence stage starts"}]}]},{"name":"Investigation","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Evidence acquisition and validation"]}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.recommendedStageId === 'Stage_Corr4a'","expressionString":"vars.recommendedStageId === 'Stage_Corr4a'"}}],"ruleName":"Flow recommends direct investigation"},{"operator":"AND","conditions":[{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Provider record request"],"cancelStagesAndTasks":true}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.providerNextStageId === 'Stage_Corr4a'","expressionString":"vars.providerNextStageId === 'Stage_Corr4a'","cancelStagesAndTasks":true}}],"ruleName":"Provider orchestration returns to investigation"},{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Supervisor review"],"cancelStagesAndTasks":true},"ruleName":"Supervisor action returned"}],"exitConditions":[{"operator":"AND","conditions":[{"exitConditionType":"TasksCompleted","parameters":{"taskNames":["Agentic Caseworker - route reviewed investigation"]}},{"exitConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Evcol2'","expressionString":"vars.caseManagerNextStageId === 'Stage_Evcol2'"}}],"ruleName":"Case Manager requests evidence refresh"},{"operator":"AND","conditions":[{"exitConditionType":"TasksCompleted","parameters":{"taskNames":["Agentic Caseworker - route reviewed investigation"]}},{"exitConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Supv7a'","expressionString":"vars.caseManagerNextStageId === 'Stage_Supv7a'"}}],"ruleName":"Case Manager requests supervisor action"}],"completionConditions":[{"operator":"AND","conditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Agentic Caseworker - first-pass investigation recommendation","Human - confirm true investigation and record findings","Agentic Caseworker - route reviewed investigation"]}},{"completionConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Clos9a'","expressionString":"vars.caseManagerNextStageId === 'Stage_Clos9a'"}}],"ruleName":"Case Manager approves closure route"}],"tasks":[{"name":"Agentic Caseworker - first-pass investigation recommendation","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Investigation"]},"ruleName":"When investigation stage starts"}]},{"name":"Human - confirm true investigation and record findings","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Agentic Caseworker - first-pass investigation recommendation"]},"ruleName":"After Agentic Caseworker first pass"}]},{"name":"Agentic Caseworker - route reviewed investigation","runOnlyOnce":false,"entryConditions":[{"entryConditionType":"TasksCompleted","parameters":{"taskNames":["Human - confirm true investigation and record findings"]},"ruleName":"After investigator checkpoint"}]}]},{"name":"Provider record request","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Evidence acquisition and validation"]}},{"entryConditionType":"Expression","parameters":{"expression":"=js:((vars.caseInput?.caseType ?? vars.caseInput?.case_type) === 'StateMedicaidHospice') && (vars.recommendedStageId === 'Stage_Prreq6')","expressionString":"((vars.caseInput?.caseType ?? vars.caseInput?.case_type) === 'StateMedicaidHospice') && (vars.recommendedStageId === 'Stage_Prreq6')"}}],"ruleName":"Hospice Flow recommendation requires hospital record"}],"exitConditions":[],"completionConditions":[{"operator":"AND","conditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["BPMN - request and await hospital record"]}},{"completionConditionType":"Expression","parameters":{"expression":"=js:vars.providerNextStageId === 'Stage_Corr4a'","expressionString":"vars.providerNextStageId === 'Stage_Corr4a'"}}],"ruleName":"Provider orchestration returns to investigation"}],"tasks":[{"name":"BPMN - request and await hospital record","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Provider record request"]},"ruleName":"When provider response stage starts"}]}]},{"name":"Supervisor review","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesExited","parameters":{"stageNames":["Investigation"],"cancelStagesAndTasks":true}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Supv7a'","expressionString":"vars.caseManagerNextStageId === 'Stage_Supv7a'","cancelStagesAndTasks":true}}],"ruleName":"Case Manager selected supervisor action"}],"exitConditions":[],"completionConditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["Human - supervisor review and disposition"]},"ruleName":"Supervisor action completed"}],"tasks":[{"name":"Human - supervisor review and disposition","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Supervisor review"]},"ruleName":"When supervisor stage starts"}]}]},{"name":"Closure and communication","entryConditions":[{"operator":"AND","conditions":[{"entryConditionType":"StagesCompleted","parameters":{"stageNames":["Investigation"]}},{"entryConditionType":"Expression","parameters":{"expression":"=js:vars.caseManagerNextStageId === 'Stage_Clos9a'","expressionString":"vars.caseManagerNextStageId === 'Stage_Clos9a'"}}],"ruleName":"Case Manager selected closure"}],"exitConditions":[],"completionConditions":[{"completionConditionType":"TasksCompleted","parameters":{"taskNames":["API - close case and persist disposition"]},"ruleName":"Case closed"}],"tasks":[{"name":"API - close case and persist disposition","runOnlyOnce":true,"entryConditions":[{"entryConditionType":"StageEntered","parameters":{"stageNames":["Closure and communication"]},"ruleName":"When closure stage starts"}]}]}],"version":1},"caseCurrentExecutionState":"=js:({ \"version\": 1, \"eventIdentifier\": vars.EventSubProcessEventIdentifier, \"event\": { \"type\": vars.EventSubProcessLatestEventType, \"parameters\": vars.EventSubProcessLatestEventParams, \"isExternal\": (vars.EventSubProcessLatestEventType == \"TaskCompleted\" || vars.EventSubProcessLatestEventType == \"SlaStatusChange\") ? false : true }, \"state\": { ...vars.caseState, \"vars\": { \"API - intake claim and select CaseType profile\": {  }, \"Agentic Caseworker - explain triage recommendation\": {  }, \"Flow - acquire and validate claim evidence\": { \"caseId\": (vars.caseId), \"caseType\": (vars.caseType), \"claimCount\": (vars.claimCount), \"lineCount\": (vars.lineCount), \"totalUnits\": (vars.totalUnits), \"totalBilled\": (vars.totalBilled), \"claimThreshold\": (vars.claimThreshold), \"thresholdExceeded\": (vars.thresholdExceeded), \"recommendedStageId\": (vars.recommendedStageId), \"routeReason\": (vars.routeReason) }, \"Agentic Caseworker - first-pass investigation recommendation\": {  }, \"Human - confirm true investigation and record findings\": { \"supervisorDecision\": (vars.investigatorDecision), \"reviewNotes\": (vars.investigatorFindings), \"recommendedAction\": (vars.investigatorRecommendedAction) }, \"Agentic Caseworker - route reviewed investigation\": { \"nextStageId\": (vars.nextStageId) }, \"BPMN - request and await hospital record\": { \"ProviderRequestStatus\": (vars.providerRequestStatus), \"HospitalRecordAvailable\": (vars.hospitalRecordAvailable), \"NextStageId\": (vars.nextStageId2), \"AuditMessage\": (vars.auditMessage) }, \"Human - supervisor review and disposition\": { \"supervisorDecision\": (vars.supervisorDecision), \"reviewNotes\": (vars.supervisorReviewNotes) }, \"API - close case and persist disposition\": {  }, \"Received event params\": { \"response\": (vars.mainEventSubprocessResponse.connectorResponse) }, \"APIEvent\": (vars.mainEventSubprocessResponse.apiEvent), \"metadata\": { \"FolderKey\": (metadata.FolderKey), \"ProcessKey\": (metadata.ProcessKey), \"InstanceId\": (metadata.InstanceId), \"ExternalId\": (metadata.ExternalId) } } } })"}]]></uipath:input>
            <uipath:output name="caseRulesDecisions" type="json" source="=result" var="caseRulesDecisions" custom="true" />
          </uipath:activity>
        </bpmn:extensionElements>
        <bpmn:incoming>edge_EventSubProcessOverlayMessageVarsNode-CaseRulesEvaluatorNode</bpmn:incoming>
        <bpmn:outgoing>edge_CaseRulesEvaluatorNode-tCaseManagerAgent</bpmn:outgoing>
      </bpmn:task>
      <bpmn:serviceTask id="tCaseManagerAgent" name="UiPath Case Agent">
        <bpmn:extensionElements>
          <uipath:tags>
            <uipath:tag key="stageId">case-manager</uipath:tag>
            <uipath:tag key="stageName">Case manager</uipath:tag>
            <uipath:tag key="caseTaskType">agent</uipath:tag>
          </uipath:tags>
          <uipath:activity version="v1">
            <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
            <uipath:context>
              <uipath:input name="name" type="string" value="=bindings.bCaseMgrName" />
              <uipath:input name="folderPath" type="string" value="=bindings.bCaseMgrFold" />
              <uipath:input name="_label" type="string" value="UiPath Case Agent" />
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"caseId":{"type":"string"},"currentStage":{"type":"string"},"groundingJson":{"type":"string"},"quickRulesJson":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"caseId":"=vars.caseId","currentStage":"Stage_Corr4a","groundingJson":"=js:JSON.stringify({caseType: vars.caseType, flowRecommendation: vars.recommendedStageId, routeReason: vars.routeReason, investigatorDecision: vars.investigatorDecision, investigatorFindings: vars.investigatorFindings, supervisorDecision: vars.supervisorDecision, supervisorReviewNotes: vars.supervisorReviewNotes})","quickRulesJson":"=js:JSON.stringify({claimThreshold: vars.claimThreshold, totalBilled: vars.totalBilled, thresholdExceeded: vars.thresholdExceeded, reviewIndicatorOnly: true})"}]]></uipath:input>
            <uipath:output name="caseManagerDecisions" type="json" source="=caseManagerDecisions" var="caseManagerDecisions" target="=caseManagerDecisions" />
          </uipath:activity>
        </bpmn:extensionElements>
        <bpmn:incoming>edge_CaseRulesEvaluatorNode-tCaseManagerAgent</bpmn:incoming>
        <bpmn:outgoing>edge_tCaseManagerAgent-Activity_Guardrails</bpmn:outgoing>
