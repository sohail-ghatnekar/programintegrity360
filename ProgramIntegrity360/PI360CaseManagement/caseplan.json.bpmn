        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions.stagesExited == null || vars.caseManagerDecisions.stagesExited.length == 0 || !vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Intake and triage' || stage.stageName == 'Evidence acquisition and validation' || stage.stageName == 'Investigation' || stage.stageName == 'Provider record request' || stage.stageName == 'Supervisor review' || stage.stageName == 'Closure and communication')) &amp;&amp; (vars.caseManagerDecisions.stagesCompleted == null || vars.caseManagerDecisions.stagesCompleted.length == 0 || !vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Intake and triage' || stage.stageName == 'Evidence acquisition and validation' || stage.stageName == 'Investigation' || stage.stageName == 'Provider record request' || stage.stageName == 'Supervisor review' || stage.stageName == 'Closure and communication'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
