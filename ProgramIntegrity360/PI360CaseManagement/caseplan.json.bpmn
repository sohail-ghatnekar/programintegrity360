        <bpmn:outgoing>edge_EventSubProcessRetrieveCaseStateNodePostCaseManager-eventSubprocessSLAParallelGateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="eventSubprocessSLAParallelGateway">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_EventSubProcessRetrieveCaseStateNodePostCaseManager-eventSubprocessSLAParallelGateway</bpmn:incoming>
        <bpmn:outgoing>edge_eventSubprocessSLAParallelGateway-eventSubprocessSLAInclusiveGateway</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessSLAParallelGateway-loopExclusiveGateway</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessSLAParallelGateway-eventSubprocessExclusiveGateway</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:inclusiveGateway id="eventSubprocessSLAInclusiveGateway">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_eventSubprocessSLAParallelGateway-eventSubprocessSLAInclusiveGateway</bpmn:incoming>
        <bpmn:outgoing>edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesExitedInclusiveGateway</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesEnteredInclusiveGateway</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessSLAInclusiveGateway-eventSubprocessNoStagesToEnterExitInclusiveGateway</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:inclusiveGateway id="eventSubprocessStagesExitedInclusiveGateway">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesExitedInclusiveGateway</bpmn:incoming>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Aintk1</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Evcol2</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Corr4a</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Prreq6</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Supv7a</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Clos9a</bpmn:outgoing>
        <bpmn:outgoing>edge_eventSubprocessStagesExitedInclusiveGateway-eventSubprocessNoValidStagesToExitEndEvent</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:intermediateThrowEvent id="stopStageSlaMessageEvent_Stage_Aintk1">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
          <uipath:event version="v1">
            <uipath:type value="Maestro.SendMessageEvent" version="v1" />
            <uipath:context>
              <uipath:input name="name" type="string" value="StopStageSlaMessage_Stage_Aintk1" />
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"Reference":{"type":"string","title":"Reference"},"SpecificContent":{"type":"object","title":"Item information"},"TimeToLive":{"type":"duration","title":"Time to live"}},"required":["Reference","name"]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"SpecificContent":{},"Reference":"=js:\"case-\" + metadata.InstanceId","Error":null,"TimeToLive":null}]]></uipath:input>
          </uipath:event>
        </bpmn:extensionElements>
        <bpmn:incoming>edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Aintk1</bpmn:incoming>
        <bpmn:messageEventDefinition messageRef="stopStageSlaMessage_Stage_Aintk1" />
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="loopExclusiveGateway">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_eventSubprocessSLAParallelGateway-loopExclusiveGateway</bpmn:incoming>
        <bpmn:outgoing>edge_loopExclusiveGateway-endCancelTaskLoopNode</bpmn:outgoing>
        <bpmn:outgoing>edge_loopExclusiveGateway-CancelTasksHandlerNode</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CancelTasksHandlerNode" name="Cancel Tasks handler">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
          <uipath:activity version="v1">
            <uipath:type value="Maestro.TaskCancellationHandler" version="v1" />
            <uipath:context>
