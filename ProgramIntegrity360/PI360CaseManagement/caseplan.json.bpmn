        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:((vars.caseManagerDecisions.stagesExited != null &amp;&amp; vars.caseManagerDecisions.stagesExited.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Provider record request')) || (vars.caseManagerDecisions.stagesCompleted != null &amp;&amp; vars.caseManagerDecisions.stagesCompleted.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Provider record request')))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Supv7a" sourceRef="eventSubprocessStagesExitedInclusiveGateway" targetRef="stopStageSlaMessageEvent_Stage_Supv7a">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:((vars.caseManagerDecisions.stagesExited != null &amp;&amp; vars.caseManagerDecisions.stagesExited.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Supervisor review')) || (vars.caseManagerDecisions.stagesCompleted != null &amp;&amp; vars.caseManagerDecisions.stagesCompleted.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Supervisor review')))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_Stage_Clos9a" sourceRef="eventSubprocessStagesExitedInclusiveGateway" targetRef="stopStageSlaMessageEvent_Stage_Clos9a">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:((vars.caseManagerDecisions.stagesExited != null &amp;&amp; vars.caseManagerDecisions.stagesExited.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Closure and communication')) || (vars.caseManagerDecisions.stagesCompleted != null &amp;&amp; vars.caseManagerDecisions.stagesCompleted.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Closure and communication')))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
