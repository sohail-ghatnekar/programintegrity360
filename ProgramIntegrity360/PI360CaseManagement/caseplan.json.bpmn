        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.caseManagerDecisions?.tasksToRun?.some((task) =&gt; !["API - intake claim and select CaseType profile","Agentic Caseworker - explain triage recommendation","Flow - acquire and validate claim evidence","Agentic Caseworker - first-pass investigation recommendation","Human - confirm true investigation and record findings","Agentic Caseworker - route reviewed investigation","BPMN - request and await hospital record","Human - supervisor review and disposition","API - close case and persist disposition"].includes(task.taskName))</bpmn:conditionExpression>
