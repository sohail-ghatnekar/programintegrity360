      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessNoStagesToEnterExitInclusiveGateway-eventSubprocessNoStagesToEnterExitEndEvent" sourceRef="eventSubprocessNoStagesToEnterExitInclusiveGateway" targetRef="eventSubprocessNoStagesToEnterExitEndEvent" />
      <bpmn:sequenceFlow id="edge_runTasksInclusiveGateway-tINT1case_SendMessageEndEvent" sourceRef="runTasksInclusiveGateway" targetRef="tINT1case_SendMessageEndEvent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.caseManagerDecisions?.tasksToRun?.some((task) =&gt; "API - intake claim and select CaseType profile" === task.taskName)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
