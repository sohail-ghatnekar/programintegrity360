{
  "version": "2.0",
  "resources": [
    {
      "resource": "process",
      "key": "solution_folder.PI360CaseManagerAgent",
      "value": {
        "name": { "defaultValue": "PI360CaseManagerAgent" },
        "folderPath": { "defaultValue": "solution_folder" }
      },
      "metadata": { "subType": "Agent" }
    },
    {
      "resource": "app",
      "key": "solution_folder.pi360-escalation-action-app",
      "value": {
        "name": {
          "defaultValue": "pi360-escalation-action-app",
          "isExpression": false,
          "displayName": "App name"
        },
        "folderPath": {
          "defaultValue": "solution_folder",
          "isExpression": false,
          "displayName": "Folder path"
        }
      },
      "metadata": {
        "bindingsVersion": "2.2",
        "solutionsSupport": "true"
      }
    }
  ]
}
