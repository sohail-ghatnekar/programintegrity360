          },
          "totalUnits": {
            "type": "number"
          },
          "totalBilled": {
            "type": "number"
          },
          "claimThreshold": {
            "type": "number"
          },
          "thresholdExceeded": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
