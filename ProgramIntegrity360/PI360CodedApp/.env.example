# Production Environment Variables
# Copy this file to .env and fill in your production values
# This file is used for production builds (npm run build)

# UiPath OAuth Client ID
# Get this from your UiPath Cloud Admin Center > External Apps
VITE_UIPATH_CLIENT_ID=your-client-id

# UiPath Organization Name
# Your organization name in UiPath Cloud (e.g., "uipathlabs")
VITE_UIPATH_ORG_NAME=your-organization

# UiPath Tenant Name
# Your tenant name in UiPath Cloud (e.g., "Playground")
VITE_UIPATH_TENANT_NAME=your-tenant

# OAuth Redirect URI for Production
# This should match the redirect URI configured in your OAuth app in Admin Center
# Example: https://your-production-domain.com
VITE_UIPATH_REDIRECT_URI=https://your-production-domain.com

# OAuth Scope
# Default scope for authentication (usually "offline_access")
VITE_UIPATH_SCOPES=OR.License OR.License.Read OR.License.Write OR.Settings OR.Settings.Read OR.Settings.Write OR.Robots OR.Robots.Read OR.Robots.Write OR.Machines OR.Machines.Read OR.Machines.Write OR.Execution OR.Execution.Read OR.Execution.Write OR.Assets OR.Assets.Read OR.Assets.Write OR.Queues OR.Queues.Read OR.Queues.Write OR.Jobs OR.Jobs.Read OR.Jobs.Write OR.Users OR.Users.Read OR.Users.Write OR.Administration OR.Administration.Read OR.Administration.Write OR.Audit OR.Audit.Read OR.Audit.Write OR.Webhooks OR.Webhooks.Read OR.Webhooks.Write OR.Monitoring OR.Monitoring.Read OR.Monitoring.Write OR.ML OR.ML.Read OR.ML.Write OR.Tasks OR.Tasks.Read OR.Tasks.Write OR.Analytics OR.Analytics.Read OR.Analytics.Write OR.Folders OR.Folders.Read OR.Folders.Write OR.BackgroundTasks OR.BackgroundTasks.Read OR.BackgroundTasks.Write OR.TestSets OR.TestSets.Read OR.TestSets.Write OR.TestSetExecutions OR.TestSetExecutions.Read OR.TestSetExecutions.Write OR.TestSetSchedules OR.TestSetSchedules.Read OR.TestSetSchedules.Write OR.TestDataQueues OR.TestDataQueues.Read OR.TestDataQueues.Write OR.Hypervisor OR.Hypervisor.Read OR.Hypervisor.Write OR.AutomationSolutions.Access PIMS DataFabric.Schema.Read DataFabric.Data.Read DataFabric.Data.Write ConversationalAgents Traces.API

# Conversational Agent Configuration
# Numeric agent ID from UiPath Cloud > Agents (e.g., 42)
VITE_CLAIMS_AGENT_ID=your-agent-id

# Comments entity configuration
# Set the comments entity ID used by the claim detail Comments panel.
# The field mappings are optional overrides when schema inference is not enough.
VITE_COMMENTS_ENTITY_ID=42dc2467-60d1-f011-8196-00224882fdd3
# VITE_COMMENTS_CLAIM_FIELD=ClaimId
# VITE_COMMENTS_TEXT_FIELD=CommentText
# VITE_COMMENTS_AUTHOR_FIELD=AuthorEmail
# VITE_COMMENTS_AUTHOR_NAME_FIELD=AuthorName
# VITE_COMMENTS_TIMESTAMP_FIELD=CreateTime
# VITE_COMMENTS_ORDER_FIELD=Order
