      {
        "id": "agentSelectNextCaseStage1.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "nextStage": {
              "type": "string",
              "description": "The recommended next stage name: EvidenceAcquisition, InvestigationRouting, ProviderResponse, SupervisorAction, or Closure."
            },
            "nextStageId": {
              "type": "string",
              "description": "Exact case stage ID selected by the agent: Stage_Evcol2, Stage_Corr4a, Stage_Prreq6, Stage_Supv7a, or Stage_Clos9a."
            },
            "routeDecision": {
              "type": "string",
              "description": "Short machine-readable routing decision."
            },
            "routeReason": {
              "type": "string",
              "description": "One or two sentence explanation grounded in the inputs."
            },
            "requiresEscalation": {
              "type": "boolean",
              "description": "True when a supervisor or policy owner must review before the case proceeds."
            },
            "humanGate": {
              "type": "string",
              "description": "Human gate that owns the next step, or none."
            },
            "completionRuleSatisfied": {
              "type": "boolean",
              "description": "True only when the required completed-stage facts are present for closure."
            },
            "actionTaken": {
              "type": "boolean",
              "description": "False. This agent routes and escalates but does not mutate the case record directly."
            },
            "factsUsed": {
              "type": "array",
              "description": "Cited facts used by the route decision.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "binding": {
          "nodeId": "agentSelectNextCaseStage1",
          "outputId": "output"
        }
      },
