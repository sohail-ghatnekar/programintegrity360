        "projectName": "PI360CaseManagerAgent",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "=bindings.bNmrKcVz5",
            "default": "PI360CaseManagerAgent"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "=bindings.b4AcADDYO",
            "default": ""
          },
          {
            "name": "_label",
            "type": "string",
            "value": "PI360CaseManagerAgent"
          }
        ]
      }
    },
    {
      "id": "buildGroundedAgentContext1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Build grounded agent context"
      },
      "inputs": {
        "script": "const normalized = $vars.normalizeCase.output;\nconst claimDetails = $vars.claimDetailsByCaseType.output || {};\nconst quickRules = $vars.quickRulesByCaseType.output || {};\nconst evidenceSnapshot = $vars.rpaEvidenceCompletenessSnapshot1.output || {};\nconst serviceEvidenceExtraction = $vars.extractServiceEvidenceIxp.output || {};\nconst institutionalEncounterExtraction = ($vars.extractInstitutionalEncounterIxp && $vars.extractInstitutionalEncounterIxp.output) || {};\nreturn {\n  groundingJson: JSON.stringify({\n    caseId: normalized.caseId,\n    caseType: normalized.caseType,\n    currentStage: normalized.currentStage,\n    caseInput: normalized.caseInput,\n    claimInput: normalized.claimInput,\n    memberInput: normalized.memberInput,\n    providerInput: normalized.providerInput,\n    serviceEventInput: normalized.serviceEventInput,\n    documentInput: normalized.documentInput,\n    claimDetails,\n    serviceEvidenceExtraction,\n    institutionalEncounterExtraction,\n    evidenceSnapshot: normalized.isHospice ? { skippedForHospice: true } : evidenceSnapshot,\n    ixpModels: {\n      serviceEvidence: 'PI360 Service Evidence Extractor',\n      institutionalEncounter: 'PI360 Institutional Encounter Extractor',\n      runtimeRegistrationPending: true\n    },\n    deterministicFacts: {\n      hospiceThreshold: 2500,\n      thresholdExceeded: Boolean(claimDetails.thresholdExceeded),\n      locationConflictMinutes: Number(quickRules.location_conflict_minutes || 0),\n      expectedHospiceOverlapMinutes: 360,\n      patientClass: normalized.patientClass || 'Observation',\n      reviewIndicatorOnly: true\n    }\n  }),\n  quickRulesJson: JSON.stringify(quickRules)\n};"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "evidenceStageSelected1",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Evidence stage selected?"
      },
      "inputs": {
        "expression": "$vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Evcol2'",
        "trueLabel": "Acquire evidence",
        "falseLabel": "Evaluate other routes"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      }
    },
    {
      "id": "routeToEvidenceAndValidation1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to evidence and validation"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Evcol2' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "endEvidenceAndValidation1",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - evidence and validation"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
