            "properties": {
              "case_id": {
                "description": "Program Integrity case identifier.",
                "title": "Case Id",
                "type": "string"
              },
              "status": {
                "description": "blocked or clear_for_case_manager.",
                "title": "Status",
                "type": "string"
              },
              "recommended_stage": {
                "description": "Recommended next ad-hoc stage for the Case Manager agent.",
                "title": "Recommended Stage",
                "type": "string"
              },
