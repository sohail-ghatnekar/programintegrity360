{
  "id": "3da6bf1e-3d42-4cd4-aa75-072a12d49572",
  "version": "1.9",
  "name": "PI360CaseManagerFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Case Manager trigger"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "Case routing payload supplied by the case manager or test harness.",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "3432a4f6-53ad-4a3a-8992-9ee2a5c036fe",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "normalizeCase",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Normalize case facts"
      },
      "inputs": {
        "script": "const raw = ($vars.start && $vars.start.output) || {};\nconst caseInput = raw.caseInput || {};\nconst claimInput = raw.claimInput || {};\nconst memberInput = raw.memberInput || {};\nconst providerInput = raw.providerInput || {};\nconst serviceEventInput = raw.serviceEventInput || {};\nconst documentInput = raw.documentInput || {};\nconst caseType = String(caseInput.caseType || caseInput.case_type || claimInput.caseType || claimInput.case_type || '').trim();\nconst allowedCaseTypes = ['MedicaidPCS', 'StateMedicaidHospice'];\nif (!allowedCaseTypes.includes(caseType)) {\n  throw new Error(`Unsupported CaseType '${caseType}'. Expected MedicaidPCS or StateMedicaidHospice.`);\n}\nconst isHospice = caseType === 'StateMedicaidHospice';\nconst caseId = String(caseInput.caseId || caseInput.case_id || (isHospice ? 'PI-HSP-2026-0042' : 'PI-PCS-2026-0041'));\nconst currentStage = String(caseInput.currentStage || caseInput.current_stage || 'Stage_Aintk1');\nconst hospitalRecordAvailable = Boolean(documentInput.hospitalRecordAvailable ?? documentInput.hospital_record_available ?? false);\nconst providerResponseNeeded = isHospice && !hospitalRecordAvailable;\nconst providerResponseReceived = !providerResponseNeeded;\nconst riskScore = Number(caseInput.riskScore ?? caseInput.risk_score ?? (isHospice ? 82 : 72));\nconst unsupportedUnits = Number(serviceEventInput.unsupportedUnits ?? serviceEventInput.unsupported_units ?? 0);\nconst patientClass = String(documentInput.patientClass ?? documentInput.patient_class ?? (isHospice ? 'Observation' : ''));\nreturn {\n  caseId,\n  caseType,\n  currentStage,\n  isHospice,\n  claimThreshold: 2500,\n  riskScore,\n  unsupportedUnits,\n  missingEvidenceCount: Number(documentInput.missingEvidenceCount ?? documentInput.missing_evidence_count ?? 0),\n  providerResponseNeeded,\n  providerResponseReceived,\n  hospitalRecordAvailable,\n  claimedServiceStartAt: String(serviceEventInput.claimedServiceStartAt ?? serviceEventInput.claimed_service_start_at ?? serviceEventInput.startAt ?? ''),\n  claimedServiceEndAt: String(serviceEventInput.claimedServiceEndAt ?? serviceEventInput.claimed_service_end_at ?? serviceEventInput.endAt ?? ''),\n  encounterArrivalAt: String(documentInput.encounterArrivalAt ?? documentInput.encounter_arrival_at ?? ''),\n  encounterDischargeAt: String(documentInput.encounterDischargeAt ?? documentInput.encounter_discharge_at ?? ''),\n  patientClass,\n  caseInput,\n  claimInput,\n  memberInput,\n  providerInput,\n  serviceEventInput,\n  documentInput\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized case routing facts.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "claimDetailsByCaseType",
      "type": "uipath.core.api-workflow.6d04d330-e36f-4da8-a0ae-b74fef97f1b4",
      "typeVersion": "1.0.0",
      "display": {
        "label": "API - retrieve CaseType claim details"
      },
      "inputs": {
        "caseType": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseType",
          "fieldType": "string"
        },
        "caseId": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseId",
          "fieldType": "string"
        },
        "claimThreshold": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.claimThreshold",
          "fieldType": "number"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": {
            "type": "literal",
            "expression": "=this",
            "fieldType": "string"
          },
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "workflowName": {
                "type": "string"
              },
              "caseType": {
                "type": "string"
              },
              "caseId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "recordsAffected": {
                "type": "number"
              },
              "claimCount": {
                "type": "number"
              },
              "lineCount": {
                "type": "number"
              },
              "totalUnits": {
                "type": "number"
              },
              "totalBilled": {
                "type": "number"
              },
              "claimThreshold": {
                "type": "number"
              },
              "thresholdExceeded": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "sourceEndpoint": {
                "type": "string"
              },
              "payload": {
                "type": "object"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": {
            "type": "literal",
            "expression": "=Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "quickRulesByCaseType",
      "type": "uipath.core.agent.fabc409c-d468-4964-92e0-2171e0ced3ba",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Rules - evaluate CaseType evidence gates",
        "icon": "coded-agent"
      },
      "inputs": {
        "case_id": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseId",
          "fieldType": "string"
        },
        "case_type": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseType",
          "fieldType": "string"
        },
        "current_stage": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.currentStage",
          "fieldType": "string"
        },
        "risk_score": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.riskScore",
          "fieldType": "number"
        },
        "claim_total_billed": {
          "type": "jsExpression",
          "expression": "$vars.claimDetailsByCaseType.output.totalBilled",
          "fieldType": "number"
        },
        "claim_threshold": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.claimThreshold",
          "fieldType": "number"
        },
        "unsupported_units": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.unsupportedUnits",
          "fieldType": "number"
        },
        "missing_evidence_count": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.missingEvidenceCount",
          "fieldType": "number"
        },
        "provider_response_needed": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.providerResponseNeeded",
          "fieldType": "boolean"
        },
        "provider_response_received": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.providerResponseReceived",
          "fieldType": "boolean"
        },
        "claimed_service_start_at": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.claimedServiceStartAt",
          "fieldType": "string"
        },
        "claimed_service_end_at": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.claimedServiceEndAt",
          "fieldType": "string"
        },
        "encounter_arrival_at": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.encounterArrivalAt",
          "fieldType": "string"
        },
        "encounter_discharge_at": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.encounterDischargeAt",
          "fieldType": "string"
        },
        "patient_class": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.patientClass",
          "fieldType": "string"
        },
        "supervisor_approved": false,
        "proposed_action": "open true investigation for human confirmation",
        "gating_json": {
          "type": "jsExpression",
          "expression": "JSON.stringify({ reviewIndicatorOnly: true, overlapMinutes: 360, patientClass: $vars.normalizeCase.output.patientClass, hospitalRecordAvailable: $vars.normalizeCase.output.hospitalRecordAvailable })",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": {
            "type": "literal",
            "expression": "=this",
            "fieldType": "string"
          },
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "case_id": {
                "description": "Program Integrity case identifier.",
                "title": "Case Id",
                "type": "string"
              },
              "status": {
                "description": "blocked or clear_for_case_manager.",
                "title": "Status",
                "type": "string"
              },
              "recommended_stage": {
                "description": "Recommended next ad-hoc stage for the Case Manager agent.",
                "title": "Recommended Stage",
                "type": "string"
              },
              "blockers": {
                "description": "Blocking rule failures that must be resolved before closure.",
                "items": {
                  "type": "string"
                },
                "title": "Blockers",
                "type": "array"
              },
              "warnings": {
                "description": "Non-blocking issues for the case manager to review.",
                "items": {
                  "type": "string"
                },
                "title": "Warnings",
                "type": "array"
              },
              "facts_checked": {
                "description": "Primitive facts used by the deterministic rules.",
                "items": {
                  "type": "string"
                },
                "title": "Facts Checked",
                "type": "array"
              },
              "supervisor_gate_required": {
                "default": false,
                "description": "True when the proposed action requires supervisor approval.",
                "title": "Supervisor Gate Required",
                "type": "boolean"
              },
              "provider_wait_required": {
                "default": false,
                "description": "True when provider response is still required.",
                "title": "Provider Wait Required",
                "type": "boolean"
              },
              "evidence_gap": {
                "default": false,
                "description": "True when material evidence is missing.",
                "title": "Evidence Gap",
                "type": "boolean"
              },
              "location_conflict_minutes": {
                "default": 0,
                "description": "Minutes where claimed home service intersects the institutional encounter.",
                "title": "Location Conflict Minutes",
                "type": "integer"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": {
            "type": "literal",
            "expression": "=Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "needsSupervisorReview",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Supervisor gate?"
      },
      "inputs": {
        "expression": "!($vars.normalizeCase.output.caseType === 'MedicaidPCS' && Number($vars.quickRulesByCaseType.output.location_conflict_minutes || 0) >= 360) && $vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Supv7a'",
        "trueLabel": "Escalate",
        "falseLabel": "Continue"
      }
    },
    {
      "id": "prepareSupervisorEscalation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Prepare escalation packet"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output || {};\nreturn { ...route, recommendedStageId: 'Stage_Supv7a', routeReason: String(route.routeReason || 'The grounded recommendation requires supervisor review before the case proceeds.') };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Supervisor escalation payload.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "needsProviderResponse",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Provider response needed?"
      },
      "inputs": {
        "expression": "($vars.normalizeCase.output.caseType === 'StateMedicaidHospice' && Number($vars.claimDetailsByCaseType.output.totalBilled || 0) >= Number($vars.claimDetailsByCaseType.output.claimThreshold || 2500) && $vars.normalizeCase.output.hospitalRecordAvailable !== true) || (!($vars.normalizeCase.output.caseType === 'MedicaidPCS' && Number($vars.quickRulesByCaseType.output.location_conflict_minutes || 0) >= 360) && $vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Prreq6')",
        "trueLabel": "Await response",
        "falseLabel": "Evaluate closure"
      }
    },
    {
      "id": "routeProviderResponse",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to provider response"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output || {};\nconst normalized = $vars.normalizeCase.output || {};\nconst claimDetails = $vars.claimDetailsByCaseType.output || {};\nconst claimThreshold = Number(claimDetails.claimThreshold || 2500);\nconst totalBilled = Number(claimDetails.totalBilled || 0);\nconst deterministicHospiceProviderRequest = normalized.caseType === 'StateMedicaidHospice' && totalBilled >= claimThreshold && normalized.hospitalRecordAvailable !== true;\nconst deterministicReason = `StateMedicaidHospice billed total ${totalBilled} meets the ${claimThreshold} threshold and the hospital record is not yet available.`;\nconst routeReason = deterministicHospiceProviderRequest ? deterministicReason : String(route.routeReason || 'The Case Manager agent selected Provider Request based on grounded evidence requirements.');\nreturn { ...route, recommendedStageId: 'Stage_Prreq6', routeReason };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Provider-response route payload.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "isClosureReady",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Closure ready?"
      },
      "inputs": {
        "expression": "!($vars.normalizeCase.output.caseType === 'MedicaidPCS' && Number($vars.quickRulesByCaseType.output.location_conflict_minutes || 0) >= 360) && $vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Clos9a'",
        "trueLabel": "Close",
        "falseLabel": "Investigate"
      }
    },
    {
      "id": "routeClosure",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to closure"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output || {};\nreturn { ...route, recommendedStageId: 'Stage_Clos9a', routeReason: String(route.routeReason || 'The grounded facts satisfy the existing lower-risk closure route.') };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Closure route payload.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "routeInvestigation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to investigation"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output || {};\nconst conflictMinutes = Number($vars.quickRulesByCaseType.output.location_conflict_minutes || 0);\nconst deterministicReason = $vars.normalizeCase.output.caseType === 'MedicaidPCS' && conflictMinutes >= 360 ? `MedicaidPCS has ${conflictMinutes} conflict minutes, meeting the 360-minute review threshold; route to Investigation for human confirmation.` : String(route.routeReason || 'The grounded recommendation routes the case to Investigation for human confirmation.');\nreturn { ...route, recommendedStageId: 'Stage_Corr4a', routeReason: deterministicReason };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Investigation route payload.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "endEscalated",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - escalation prepared"
      },
      "inputs": {},
      "outputs": {
        "caseId": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseId"
        },
        "caseType": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseType"
        },
        "claimCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimCount"
        },
        "lineCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.lineCount"
        },
        "totalUnits": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalUnits"
        },
        "totalBilled": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalBilled"
        },
        "claimThreshold": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimThreshold"
        },
        "thresholdExceeded": {
          "source": "=js:$vars.claimDetailsByCaseType.output.thresholdExceeded"
        },
        "recommendedStageId": {
          "source": "=js:$vars.prepareSupervisorEscalation.output.recommendedStageId"
        },
        "routeReason": {
          "source": "=js:$vars.prepareSupervisorEscalation.output.routeReason"
        }
      }
    },
    {
      "id": "endProvider",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - await provider"
      },
      "inputs": {},
      "outputs": {
        "caseId": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseId"
        },
        "caseType": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseType"
        },
        "claimCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimCount"
        },
        "lineCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.lineCount"
        },
        "totalUnits": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalUnits"
        },
        "totalBilled": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalBilled"
        },
        "claimThreshold": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimThreshold"
        },
        "thresholdExceeded": {
          "source": "=js:$vars.claimDetailsByCaseType.output.thresholdExceeded"
        },
        "recommendedStageId": {
          "source": "=js:$vars.routeProviderResponse.output.recommendedStageId"
        },
        "routeReason": {
          "source": "=js:$vars.routeProviderResponse.output.routeReason"
        }
      }
    },
    {
      "id": "endClosure",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - closure"
      },
      "inputs": {},
      "outputs": {
        "caseId": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseId"
        },
        "caseType": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseType"
        },
        "claimCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimCount"
        },
        "lineCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.lineCount"
        },
        "totalUnits": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalUnits"
        },
        "totalBilled": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalBilled"
        },
        "claimThreshold": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimThreshold"
        },
        "thresholdExceeded": {
          "source": "=js:$vars.claimDetailsByCaseType.output.thresholdExceeded"
        },
        "recommendedStageId": {
          "source": "=js:$vars.routeClosure.output.recommendedStageId"
        },
        "routeReason": {
          "source": "=js:$vars.routeClosure.output.routeReason"
        }
      }
    },
    {
      "id": "endInvestigation",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - investigate"
      },
      "inputs": {},
      "outputs": {
        "caseId": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseId"
        },
        "caseType": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseType"
        },
        "claimCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimCount"
        },
        "lineCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.lineCount"
        },
        "totalUnits": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalUnits"
        },
        "totalBilled": {
