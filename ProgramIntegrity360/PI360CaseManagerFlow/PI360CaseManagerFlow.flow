      "nodeType": "core.logic.decision",
      "version": "1.2",
      "category": "control-flow",
      "description": "Branch on a true or false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 21,
      "display": {
        "label": "Decision",
