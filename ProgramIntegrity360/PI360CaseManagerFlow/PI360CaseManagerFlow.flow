{
  "id": "3da6bf1e-3d42-4cd4-aa75-072a12d49572",
  "version": "1.9",
  "name": "PI360CaseManagerFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Case Manager trigger"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "Case routing payload supplied by the case manager or test harness.",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "3432a4f6-53ad-4a3a-8992-9ee2a5c036fe",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "normalizeCase",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Normalize case facts"
      },
      "inputs": {
        "script": "const raw = ($vars.start && $vars.start.output) || {};\nconst caseInput = raw.caseInput || {};\nconst claimInput = raw.claimInput || {};\nconst memberInput = raw.memberInput || {};\nconst providerInput = raw.providerInput || {};\nconst serviceEventInput = raw.serviceEventInput || {};\nconst documentInput = raw.documentInput || {};\nconst caseType = String(caseInput.caseType || caseInput.case_type || claimInput.caseType || claimInput.case_type || '').trim();\nconst allowedCaseTypes = ['MedicaidPCS', 'StateMedicaidHospice'];\nif (!allowedCaseTypes.includes(caseType)) {\n  throw new Error(`Unsupported CaseType '${caseType}'. Expected MedicaidPCS or StateMedicaidHospice.`);\n}\nconst isHospice = caseType === 'StateMedicaidHospice';\nconst caseId = String(caseInput.caseId || caseInput.case_id || (isHospice ? 'PI-HSP-2026-0042' : 'PI-PCS-2026-0041'));\nconst currentStage = String(caseInput.currentStage || caseInput.current_stage || 'Stage_Aintk1');\nconst hospitalRecordAvailable = Boolean(documentInput.hospitalRecordAvailable ?? documentInput.hospital_record_available ?? documentInput.institutionalEncounterAvailable ?? false);\nconst providerResponseNeeded = isHospice && !hospitalRecordAvailable;\nconst providerResponseReceived = !providerResponseNeeded;\nconst claimTotalBilled = Number(claimInput.totalBilled ?? claimInput.total_billed ?? 0);\nconst riskScore = Number(caseInput.riskScore ?? caseInput.risk_score ?? (isHospice ? 82 : 72));\nconst unsupportedUnits = Number(serviceEventInput.unsupportedUnits ?? serviceEventInput.unsupported_units ?? 0);\nconst patientClass = String(documentInput.patientClass ?? documentInput.patient_class ?? (isHospice ? 'Observation' : ''));\nreturn {\n  caseId,\n  caseType,\n  currentStage,\n  isHospice,\n  claimThreshold: 2500,\n  claimTotalBilled,\n  riskScore,\n  unsupportedUnits,\n  missingEvidenceCount: Number(documentInput.missingEvidenceCount ?? documentInput.missing_evidence_count ?? 0),\n  providerResponseNeeded,\n  providerResponseReceived,\n  hospitalRecordAvailable,\n  claimedServiceStartAt: String(serviceEventInput.claimedServiceStartAt ?? serviceEventInput.claimed_service_start_at ?? serviceEventInput.startAt ?? ''),\n  claimedServiceEndAt: String(serviceEventInput.claimedServiceEndAt ?? serviceEventInput.claimed_service_end_at ?? serviceEventInput.endAt ?? ''),\n  encounterArrivalAt: String(documentInput.encounterArrivalAt ?? documentInput.encounter_arrival_at ?? ''),\n  encounterDischargeAt: String(documentInput.encounterDischargeAt ?? documentInput.encounter_discharge_at ?? ''),\n  patientClass,\n  claimsAvailable: Boolean(documentInput.claimsAvailable ?? documentInput.claims_available ?? true),\n  evvAvailable: isHospice ? true : Boolean(documentInput.evvAvailable ?? documentInput.evv_available ?? true),\n  planOfCareAvailable: isHospice ? true : Boolean(documentInput.planOfCareAvailable ?? documentInput.plan_of_care_available ?? true),\n  enrollmentAvailable: Boolean(documentInput.enrollmentAvailable ?? documentInput.enrollment_available ?? true),\n  providerPacketAvailable: isHospice ? hospitalRecordAvailable : Boolean(documentInput.providerPacketAvailable ?? documentInput.provider_packet_available ?? true),\n  caseInput,\n  claimInput,\n  memberInput,\n  providerInput,\n  serviceEventInput,\n  documentInput\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized case routing facts.",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error"
        }
      }
    },
    {
      "id": "claimDetailsByCaseType",
      "type": "uipath.core.api-workflow.6d04d330-e36f-4da8-a0ae-b74fef97f1b4",
