    {
      "id": "agentSelectNextCaseStage1",
      "type": "uipath.core.agent.64ee0873-ac2c-4393-a970-7f67f9c7a423",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Agent - select next case stage"
      },
      "inputs": {
        "caseId": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseId",
          "fieldType": "string"
        },
        "currentStage": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.currentStage",
          "fieldType": "string"
        },
        "groundingJson": {
          "type": "jsExpression",
          "expression": "$vars.buildGroundedCaseContext.output.groundingJson",
          "fieldType": "string"
        },
        "quickRulesJson": {
          "type": "jsExpression",
          "expression": "$vars.buildGroundedCaseContext.output.quickRulesJson",
          "fieldType": "string"
        }
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "64ee0873-ac2c-4393-a970-7f67f9c7a423",
          "orchestratorType": "agent",
          "values": {
            "name": "PI360CaseManagerAgent",
            "folderPath": ""
          }
        },
        "projectId": "72209049-a669-4dee-af0f-f67a87df1253",
        "projectName": "PI360CaseManagerAgent",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "=bindings.bNmrKcVz5",
            "default": "PI360CaseManagerAgent"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "=bindings.b4AcADDYO",
            "default": ""
          },
          {
            "name": "_label",
            "type": "string",
            "value": "PI360CaseManagerAgent"
          }
        ]
      }
    },
    {
      "id": "buildGroundedCaseContext",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Build grounded agent context"
      },
      "inputs": {
        "script": "const normalized = $vars.normalizeCase.output;\nconst claimDetails = $vars.claimDetailsByCaseType.output || {};\nconst quickRules = $vars.quickRulesByCaseType.output || {};\nif (String(claimDetails.caseType || '') !== normalized.caseType) {\n  throw new Error(`Claim response CaseType '${claimDetails.caseType}' does not match requested CaseType '${normalized.caseType}'.`);\n}\nconst claimThreshold = Number(claimDetails.claimThreshold ?? normalized.claimThreshold ?? 2500);\nconst totalBilled = Number(claimDetails.totalBilled ?? 0);\nconst thresholdExceeded = Boolean(claimDetails.thresholdExceeded);\nconst locationConflictMinutes = Number(quickRules.location_conflict_minutes || 0);\nconst allowedNextStageIds = ['Stage_Evcol2', 'Stage_Corr4a', 'Stage_Prreq6', 'Stage_Supv7a', 'Stage_Clos9a'];\nconst deterministicProviderRequest = normalized.caseType === 'StateMedicaidHospice' && totalBilled >= claimThreshold && normalized.hospitalRecordAvailable !== true;\nconst deterministicPcsInvestigation = normalized.caseType === 'MedicaidPCS' && locationConflictMinutes >= 360;\nreturn {\n  groundingJson: JSON.stringify({\n    caseId: claimDetails.caseId || normalized.caseId,\n    caseType: claimDetails.caseType || normalized.caseType,\n    currentStage: normalized.currentStage,\n    caseInput: normalized.caseInput,\n    claimInput: normalized.claimInput,\n    memberInput: normalized.memberInput,\n    providerInput: normalized.providerInput,\n    serviceEventInput: normalized.serviceEventInput,\n    documentInput: normalized.documentInput,\n    claimDetails: {\n      claimCount: Number(claimDetails.claimCount || 0),\n      lineCount: Number(claimDetails.lineCount || 0),\n      totalUnits: Number(claimDetails.totalUnits || 0),\n      totalBilled,\n      claimThreshold,\n      thresholdExceeded,\n      sourceEndpoint: claimDetails.sourceEndpoint || '',\n      payload: claimDetails.payload || {}\n    },\n    quickRules,\n    allowedNextStageIds,\n    deterministicFacts: {\n      deterministicProviderRequest,\n      deterministicPcsInvestigation,\n      locationConflictMinutes,\n      patientClass: normalized.patientClass || 'Observation',\n      hospitalRecordAvailable: normalized.hospitalRecordAvailable === true,\n      reviewIndicatorOnly: true\n    },\n    documentProcessing: { executed: false, source: 'supplied metadata only' }\n  }),\n  quickRulesJson: JSON.stringify({ ...quickRules, allowedNextStageIds, deterministicProviderRequest, deterministicPcsInvestigation })\n};"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "evidenceStageSelected1",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Evidence stage selected?"
      },
      "inputs": {
        "expression": "!($vars.normalizeCase.output.caseType === 'MedicaidPCS' && Number($vars.quickRulesByCaseType.output.location_conflict_minutes || 0) >= 360) && $vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Evcol2'",
        "trueLabel": "Acquire evidence",
        "falseLabel": "Evaluate other routes"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      }
    },
    {
      "id": "routeToEvidenceAndValidation1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to evidence and validation"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output || {};\nreturn { ...route, recommendedStageId: 'Stage_Evcol2', routeReason: String(route.routeReason || 'Required claim or supplied document metadata is incomplete, so the case remains in evidence review.') };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "endEvidenceAndValidation1",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - evidence and validation"
      },
      "inputs": {},
      "outputs": {
        "caseId": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseId"
        },
        "caseType": {
          "source": "=js:$vars.claimDetailsByCaseType.output.caseType"
        },
        "claimCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimCount"
        },
        "lineCount": {
          "source": "=js:$vars.claimDetailsByCaseType.output.lineCount"
        },
        "totalUnits": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalUnits"
        },
        "totalBilled": {
          "source": "=js:$vars.claimDetailsByCaseType.output.totalBilled"
        },
        "claimThreshold": {
          "source": "=js:$vars.claimDetailsByCaseType.output.claimThreshold"
        },
        "thresholdExceeded": {
          "source": "=js:$vars.claimDetailsByCaseType.output.thresholdExceeded"
        },
        "recommendedStageId": {
          "source": "=js:$vars.routeToEvidenceAndValidation1.output.recommendedStageId"
        },
        "routeReason": {
          "source": "=js:$vars.routeToEvidenceAndValidation1.output.routeReason"
        }
      },
      "model": {
        "type": "bpmn:EndEvent"
      }
    },
