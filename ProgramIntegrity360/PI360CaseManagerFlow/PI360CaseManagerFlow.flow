    {
      "id": "edge-provider-false",
      "sourceNodeId": "needsProviderResponse",
      "sourcePort": "false",
      "targetNodeId": "isClosureReady",
      "targetPort": "input"
    },
    {
      "id": "edge-provider-end",
      "sourceNodeId": "routeProviderResponse",
      "sourcePort": "success",
      "targetNodeId": "endProvider",
