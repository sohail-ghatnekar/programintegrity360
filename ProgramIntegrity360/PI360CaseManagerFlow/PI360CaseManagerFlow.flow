{
  "id": "3da6bf1e-3d42-4cd4-aa75-072a12d49572",
  "version": "1.0.0",
  "name": "PI360CaseManagerFlow",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Case Manager trigger"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "Case routing payload supplied by the case manager or test harness.",
          "source": "null",
          "var": "output"
        }
      },
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "3432a4f6-53ad-4a3a-8992-9ee2a5c036fe",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "normalizeCase",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Normalize case facts"
      },
      "inputs": {
        "script": "const raw = ($vars.start && $vars.start.output) || {};\nconst payload = raw.payload || raw.case || raw;\nconst quickRules = payload.quickRules || payload.rules || {};\nreturn {\n  caseId: String(payload.caseId || payload.id || 'PI-PCS-2026-0041'),\n  currentStage: String(payload.currentStage || payload.stage || 'Stage_Aintk1'),\n  claimsAvailable: Boolean(payload.claimsAvailable ?? true),\n  evvAvailable: Boolean(payload.evvAvailable ?? true),\n  planOfCareAvailable: Boolean(payload.planOfCareAvailable ?? true),\n  enrollmentAvailable: Boolean(payload.enrollmentAvailable ?? true),\n  providerPacketAvailable: Boolean(payload.providerPacketAvailable ?? !payload.providerResponseNeeded),\n  grounding: payload,\n  quickRules\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized case routing facts.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "needsSupervisorReview",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Supervisor gate?"
      },
      "inputs": {
        "expression": "$vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Supv7a'",
        "trueLabel": "Escalate",
        "falseLabel": "Continue"
      }
    },
    {
      "id": "prepareSupervisorEscalation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Prepare escalation packet"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Supv7a' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Supervisor escalation payload.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "needsProviderResponse",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Provider response needed?"
      },
      "inputs": {
        "expression": "$vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Prreq6'",
        "trueLabel": "Await response",
        "falseLabel": "Evaluate closure"
      }
    },
    {
      "id": "routeProviderResponse",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to provider response"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Prreq6' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Provider-response route payload.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isClosureReady",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Closure ready?"
      },
      "inputs": {
        "expression": "$vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Clos9a'",
        "trueLabel": "Close",
        "falseLabel": "Investigate"
      }
    },
    {
      "id": "routeClosure",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to closure"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Clos9a' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Closure route payload.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeInvestigation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to investigation"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Corr4a' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Investigation route payload.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endEscalated",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - escalation prepared"
      },
      "inputs": {}
    },
    {
      "id": "endProvider",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - await provider"
      },
      "inputs": {}
    },
    {
      "id": "endClosure",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - closure"
      },
      "inputs": {}
    },
    {
      "id": "endInvestigation",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - investigate"
      },
      "inputs": {}
    },
    {
      "id": "rpaEvidenceCompletenessSnapshot1",
      "type": "uipath.core.rpa-workflow.58e4aa89-7358-47ee-a0d4-6711e9792208",
      "typeVersion": "1.0.0",
      "display": {
        "label": "RPA - evidence completeness snapshot"
      },
      "inputs": {
        "in_CaseId": "=js:$vars.normalizeCase.output.caseId",
        "in_ClaimsAvailable": "=js:$vars.normalizeCase.output.claimsAvailable",
        "in_EvvAvailable": "=js:$vars.normalizeCase.output.evvAvailable",
        "in_PlanOfCareAvailable": "=js:$vars.normalizeCase.output.planOfCareAvailable",
        "in_EnrollmentAvailable": "=js:$vars.normalizeCase.output.enrollmentAvailable",
        "in_ProviderPacketAvailable": "=js:$vars.normalizeCase.output.providerPacketAvailable"
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartJob",
        "version": "v2",
        "bindings": {
          "resource": "process",
          "resourceSubType": "Process",
          "resourceKey": "58e4aa89-7358-47ee-a0d4-6711e9792208",
          "orchestratorType": "process",
          "values": {
            "name": "PI360EvidenceSnapshotAutomation",
            "folderPath": ""
          }
        },
        "projectId": "58e4aa89-7358-47ee-a0d4-6711e9792208",
        "projectName": "PI360EvidenceSnapshotAutomation",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "=bindings.bybLZkmcn",
            "default": "PI360EvidenceSnapshotAutomation"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "=bindings.bHJVld2gM",
            "default": ""
          },
          {
            "name": "_label",
            "type": "string",
            "value": "PI360EvidenceSnapshotAutomation"
          }
        ]
      }
    },
    {
      "id": "agentSelectNextCaseStage1",
      "type": "uipath.core.agent.64ee0873-ac2c-4393-a970-7f67f9c7a423",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Agent - select next case stage"
      },
      "inputs": {
        "caseId": "=js:$vars.normalizeCase.output.caseId",
        "currentStage": "=js:$vars.normalizeCase.output.currentStage",
        "groundingJson": "=js:$vars.buildGroundedAgentContext1.output.groundingJson",
        "quickRulesJson": "=js:$vars.buildGroundedAgentContext1.output.quickRulesJson"
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "64ee0873-ac2c-4393-a970-7f67f9c7a423",
          "orchestratorType": "agent",
          "values": {
            "name": "PI360CaseManagerAgent",
            "folderPath": ""
          }
        },
        "projectId": "72209049-a669-4dee-af0f-f67a87df1253",
        "projectName": "PI360CaseManagerAgent",
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "=bindings.bNmrKcVz5",
            "default": "PI360CaseManagerAgent"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "=bindings.b4AcADDYO",
            "default": ""
          },
          {
            "name": "_label",
            "type": "string",
            "value": "PI360CaseManagerAgent"
          }
        ]
      }
    },
    {
      "id": "buildGroundedAgentContext1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Build grounded agent context"
      },
      "inputs": {
        "script": "const normalized = $vars.normalizeCase.output;\nconst evidenceSnapshot = $vars.rpaEvidenceCompletenessSnapshot1.output || {};\nreturn {\n  groundingJson: JSON.stringify({\n    ...normalized.grounding,\n    caseId: normalized.caseId,\n    currentStage: normalized.currentStage,\n    evidenceSnapshot\n  }),\n  quickRulesJson: JSON.stringify(normalized.quickRules || {})\n};"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "evidenceStageSelected1",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Evidence stage selected?"
      },
      "inputs": {
        "expression": "$vars.agentSelectNextCaseStage1.output.nextStageId === 'Stage_Evcol2'",
        "trueLabel": "Acquire evidence",
        "falseLabel": "Evaluate other routes"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      }
    },
    {
      "id": "routeToEvidenceAndValidation1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Route to evidence and validation"
      },
      "inputs": {
        "script": "const route = $vars.agentSelectNextCaseStage1.output;\nreturn { ...route, selectedStageId: 'Stage_Evcol2' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "endEvidenceAndValidation1",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End - evidence and validation"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-normalize",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "normalizeCase",
      "targetPort": "input"
    },
