    {
      "id": "evidenceSnapshotRpa",
      "type": "uipath.core.rpa-workflow.58e4aa89-7358-47ee-a0d4-6711e9792208",
      "typeVersion": "1.0.0",
      "display": {
        "label": "RPA placeholder - extract service evidence"
      },
      "inputs": {
        "in_CaseId": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseId",
          "fieldType": "string"
        },
        "in_ClaimsAvailable": true,
        "in_EvvAvailable": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseType === \"MedicaidPCS\"",
          "fieldType": "boolean"
        },
        "in_PlanOfCareAvailable": true,
        "in_EnrollmentAvailable": true,
        "in_ProviderPacketAvailable": {
          "type": "jsExpression",
          "expression": "$vars.normalizeCase.output.caseType === \"StateMedicaidHospice\" ? $vars.normalizeCase.output.hospitalRecordAvailable : true",
          "fieldType": "boolean"
        }
      }
    },
