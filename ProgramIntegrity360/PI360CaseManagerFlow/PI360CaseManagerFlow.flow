          "connectionFolderKey": "5db31dd1-1073-4f9e-b44b-76f5484e03c4",
          "method": "POST",
          "endpoint": "/v2/{entityName}/CreateEntityRecord",
          "bodyParameters": {
            "doc_id": "=js:String($vars.normalizeCase.output.documentInput.documentId || $vars.normalizeCase.output.documentInput.document_id || $vars.normalizeCase.output.caseId + \"-SERVICE-EVIDENCE\")",
            "case_id": "=js:$vars.normalizeCase.output.caseId",
            "doc_type": 0,
            "source_system": "Orchestrator Storage Bucket",
            "storage_uri": "=js:String($vars.normalizeCase.output.documentInput.storageUri || $vars.normalizeCase.output.documentInput.storage_uri || $vars.normalizeCase.output.documentInput.fileName || \"\")",
            "extracted_fields": "=js:JSON.stringify($vars.evidenceSnapshotRpa.output || {})",
            "extraction_confidence": "=js:Number($vars.normalizeCase.output.documentInput.extractionConfidence || $vars.normalizeCase.output.documentInput.extraction_confidence || 0)",
            "validation_status": 0,
            "validated_by": "=js:$vars.normalizeCase.output.documentInput.validatedBy || \"PI360 automation\"",
            "note": "=js:$vars.normalizeCase.output.isHospice ? \"Claim and service evidence were staged; the provider hospital record is acquired by the ad-hoc BPMN before any location-conflict finding.\" : \"Timesheet evidence was processed for PCS validation.\"",
            "ixp_model": "PI360 Timesheet Extraction",
            "ixp_model_version": "live",
            "reference_only": false,
            "patient_class": "=js:$vars.normalizeCase.output.patientClass",
            "encounter_id": "=js:String($vars.normalizeCase.output.documentInput.encounterId || $vars.normalizeCase.output.documentInput.encounter_id || \"\")",
            "facility_name": "=js:String($vars.normalizeCase.output.documentInput.facilityName || $vars.normalizeCase.output.documentInput.facility_name || \"\")",
            "care_area": "=js:String($vars.normalizeCase.output.documentInput.careArea || $vars.normalizeCase.output.documentInput.care_area || \"\")",
            "encounter_arrival_at": "=js:$vars.normalizeCase.output.encounterArrivalAt",
            "encounter_discharge_at": "=js:$vars.normalizeCase.output.encounterDischargeAt",
            "encounter_disposition": "=js:String($vars.normalizeCase.output.documentInput.encounterDisposition || $vars.normalizeCase.output.documentInput.encounter_disposition || \"\")"
          },
          "queryParameters": {
            "expansionLevel": 1
          },
          "pathParameters": {
            "entityName": "PI360EvidenceDocument"
          },
          "uiPathActivityTypeId": "dfd2bc7a-ca4b-3316-8a1f-57c9e106dfbf",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"CreateEntityRecordCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"CreateEntityRecordCurated\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/CreateEntityRecord\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"PI360EvidenceDocument\"]]},\"unifiedTypesCompatible\":true}}"
        }
      }
