<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_PI360_AdHocReview"
    targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL"
    exporter="UiPath Studio Web (https://uipath.com)"
    exporterVersion="1.199.0">
  <bpmn:process id="Process_1" name="PI360 Ad Hoc Review BPMN" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="Var_CaseId" name="CaseId" type="string" elementId="Event_Start" default="PI-HSP-2026-0042" />
        <uipath:input id="Var_CaseType" name="CaseType" type="string" elementId="Event_Start" default="StateMedicaidHospice" />
        <uipath:input id="Var_ProviderId" name="ProviderId" type="string" elementId="Event_Start" default="PRV-HSP-2042" />
        <uipath:inputOutput id="Var_HospitalRecordAvailable" name="HospitalRecordAvailable" type="boolean" elementId="Event_Start" default="false" />
        <uipath:input id="Var_InvestigatorProceed" name="InvestigatorProceed" type="boolean" elementId="Event_Start" default="false" />
        <uipath:output id="Var_ProviderRequestStatus" name="ProviderRequestStatus" type="string" elementId="Event_Start" />
        <uipath:output id="Var_NextStageId" name="NextStageId" type="string" elementId="Event_Start" />
        <uipath:output id="Var_AuditMessage" name="AuditMessage" type="string" elementId="Event_Start" />
        <uipath:inputOutput id="Var_RequestResponse" name="RequestHospitalRecordResponse" type="Orchestrator.RunJob" elementId="Task_RequestHospitalRecord" />
        <uipath:inputOutput id="Var_IntakeResponse" name="IntakeHospitalRecordResponse" type="Orchestrator.RunJob" elementId="Task_IntakeHospitalRecord" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Bind_ApiKey" name="releaseKey" type="string" resource="process" resourceSubType="Api" resourceKey="solution_folder.PI360ApiWorkflows" propertyAttribute="Key" />
        <uipath:binding id="Bind_ApiFolder" name="folderPath" type="string" default="solution_folder" resource="process" resourceSubType="Api" resourceKey="solution_folder.PI360ApiWorkflows" propertyAttribute="folderPath" />
        <uipath:binding id="Bind_ApiName" name="name" type="string" default="PI360ApiWorkflows" resource="process" resourceSubType="Api" resourceKey="solution_folder.PI360ApiWorkflows" propertyAttribute="name" />
      </uipath:bindings>
      <uipath:migrationVersion version="18" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_Start" name="Provider record review">
      <bpmn:extensionElements>
        <uipath:entryPointId value="653364ff-7770-494b-b2e3-9d0217d16635" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_ProceedGate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_InvestigatorProceed" name="Investigator proceed?" default="Flow_Proceed_Blocked">
      <bpmn:incoming>Flow_Start_ProceedGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceed_Request</bpmn:outgoing>
      <bpmn:outgoing>Flow_Proceed_Blocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestHospitalRecord" name="API: Request hospital record">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="=bindings.Bind_ApiKey" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="=bindings.Bind_ApiFolder" />
            <uipath:input name="name" value="=bindings.Bind_ApiName" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"workflowName":"RequestHospitalRecord","caseType":"=vars.Var_CaseType","caseId":"=vars.Var_CaseId","providerId":"=vars.Var_ProviderId","hospitalRecordAvailable":"=vars.Var_HospitalRecordAvailable","investigatorProceed":"=vars.Var_InvestigatorProceed"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_RequestResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Proceed_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_AwaitProviderResponse" name="Await response (P3D)">
      <bpmn:incoming>Flow_Request_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_RecordGate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_HospitalRecordAvailable" name="Hospital record available?" default="Flow_Record_Awaiting">
      <bpmn:incoming>Flow_Timer_RecordGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_Intake</bpmn:outgoing>
      <bpmn:outgoing>Flow_Record_Awaiting</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_IntakeHospitalRecord" name="API: Intake hospital record">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="=bindings.Bind_ApiKey" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="=bindings.Bind_ApiFolder" />
            <uipath:input name="name" value="=bindings.Bind_ApiName" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"workflowName":"IntakeHospitalRecord","caseType":"=vars.Var_CaseType","caseId":"=vars.Var_CaseId","providerId":"=vars.Var_ProviderId","hospitalRecordAvailable":"=vars.Var_HospitalRecordAvailable","investigatorProceed":"=vars.Var_InvestigatorProceed"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_IntakeResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Record_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_Intake_Investigation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_EndBlocked" name="Blocked: investigator approval required">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="ProviderRequestStatus" type="string" source="Blocked" var="Var_ProviderRequestStatus" />
          <uipath:output name="HospitalRecordAvailable" type="boolean" source="=vars.Var_HospitalRecordAvailable" var="Var_HospitalRecordAvailable" />
          <uipath:output name="NextStageId" type="string" source="Stage_Prreq6" var="Var_NextStageId" />
          <uipath:output name="AuditMessage" type="string" source="Provider record request blocked until investigator approval; no analysis was performed." var="Var_AuditMessage" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Proceed_Blocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndAwaitingProvider" name="Awaiting provider record">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="ProviderRequestStatus" type="string" source="TimedOutAwaitingProvider" var="Var_ProviderRequestStatus" />
          <uipath:output name="HospitalRecordAvailable" type="boolean" source="=vars.Var_HospitalRecordAvailable" var="Var_HospitalRecordAvailable" />
          <uipath:output name="NextStageId" type="string" source="Stage_Prreq6" var="Var_NextStageId" />
          <uipath:output name="AuditMessage" type="string" source="Provider response window expired after P3D without a hospital record; no analysis was performed." var="Var_AuditMessage" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Record_Awaiting</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndInvestigation" name="Return to Investigation">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="ProviderRequestStatus" type="string" source="Completed" var="Var_ProviderRequestStatus" />
          <uipath:output name="HospitalRecordAvailable" type="boolean" source="=vars.Var_HospitalRecordAvailable" var="Var_HospitalRecordAvailable" />
          <uipath:output name="NextStageId" type="string" source="Stage_Corr4a" var="Var_NextStageId" />
          <uipath:output name="AuditMessage" type="string" source="Hospital record received and intake completed; return to Investigation." var="Var_AuditMessage" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Intake_Investigation</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ProceedGate" sourceRef="Event_Start" targetRef="Gateway_InvestigatorProceed" />
    <bpmn:sequenceFlow id="Flow_Proceed_Request" sourceRef="Gateway_InvestigatorProceed" targetRef="Task_RequestHospitalRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_InvestigatorProceed == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Proceed_Blocked" sourceRef="Gateway_InvestigatorProceed" targetRef="Event_EndBlocked" />
    <bpmn:sequenceFlow id="Flow_Request_Timer" sourceRef="Task_RequestHospitalRecord" targetRef="Event_AwaitProviderResponse" />
    <bpmn:sequenceFlow id="Flow_Timer_RecordGate" sourceRef="Event_AwaitProviderResponse" targetRef="Gateway_HospitalRecordAvailable" />
    <bpmn:sequenceFlow id="Flow_Record_Intake" sourceRef="Gateway_HospitalRecordAvailable" targetRef="Task_IntakeHospitalRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_HospitalRecordAvailable == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Record_Awaiting" sourceRef="Gateway_HospitalRecordAvailable" targetRef="Event_EndAwaitingProvider" />
    <bpmn:sequenceFlow id="Flow_Intake_Investigation" sourceRef="Task_IntakeHospitalRecord" targetRef="Event_EndInvestigation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Event_Start"><dc:Bounds x="120" y="220" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ProceedGate" bpmnElement="Gateway_InvestigatorProceed"><dc:Bounds x="220" y="213" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Request" bpmnElement="Task_RequestHospitalRecord"><dc:Bounds x="340" y="198" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer" bpmnElement="Event_AwaitProviderResponse"><dc:Bounds x="570" y="220" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RecordGate" bpmnElement="Gateway_HospitalRecordAvailable"><dc:Bounds x="670" y="213" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Intake" bpmnElement="Task_IntakeHospitalRecord"><dc:Bounds x="790" y="198" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InvestigationEnd" bpmnElement="Event_EndInvestigation"><dc:Bounds x="1020" y="220" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BlockedEnd" bpmnElement="Event_EndBlocked"><dc:Bounds x="340" y="350" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AwaitingEnd" bpmnElement="Event_EndAwaitingProvider"><dc:Bounds x="790" y="350" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Start_ProceedGate" bpmnElement="Flow_Start_ProceedGate"><di:waypoint x="156" y="238" /><di:waypoint x="220" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Proceed_Request" bpmnElement="Flow_Proceed_Request"><di:waypoint x="270" y="238" /><di:waypoint x="340" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Proceed_Blocked" bpmnElement="Flow_Proceed_Blocked"><di:waypoint x="245" y="263" /><di:waypoint x="245" y="368" /><di:waypoint x="340" y="368" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Request_Timer" bpmnElement="Flow_Request_Timer"><di:waypoint x="500" y="238" /><di:waypoint x="570" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Timer_RecordGate" bpmnElement="Flow_Timer_RecordGate"><di:waypoint x="606" y="238" /><di:waypoint x="670" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Record_Intake" bpmnElement="Flow_Record_Intake"><di:waypoint x="720" y="238" /><di:waypoint x="790" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Record_Awaiting" bpmnElement="Flow_Record_Awaiting"><di:waypoint x="695" y="263" /><di:waypoint x="695" y="368" /><di:waypoint x="790" y="368" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Intake_Investigation" bpmnElement="Flow_Intake_Investigation"><di:waypoint x="950" y="238" /><di:waypoint x="1020" y="238" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
