    {
      "id": "stage-2",
      "sequence": 2,
      "name": "Automated evidence collection",
      "status": "In Review",
      "purpose": "Pull claims, EVV, POC, and documents into Data Fabric + buckets, then run deterministic RS-01..RS-05 and exposure math.",
      "entryCondition": { "type": "gate", "expression": "stage-1 complete" },
      "exitCondition": { "type": "gate", "expression": "all source records landed AND RS-01..RS-05 written AND exposure fields populated" },
      "sla": { "duration": "P1D", "basis": "business-days" },
